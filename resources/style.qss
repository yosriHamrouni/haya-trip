/* Haya Trip — application theme.
   Palette: ink #0f172a, muted #64748b, line #e2e8f0, background #f1f5f9,
   primary #2563eb, accent #14b8a6. Widgets keep the fixed geometry from the
   original .ui files, so padding stays compact. */

QMainWindow, QDialog {
    background: #f1f5f9;
}

QWidget {
    color: #0f172a;
    selection-background-color: #dbeafe;
    selection-color: #0f172a;
}

QLabel {
    background: transparent;
    color: #334155;
}

QFrame {
    background: transparent;
}

/* ---------- Top navigation (one tab per module) ---------- */

QTabWidget#tabWidget::pane {
    border: none;
    border-top: 1px solid #e2e8f0;
    background: #f1f5f9;
    top: -1px;
}

QTabWidget#tabWidget > QTabBar::tab {
    background: transparent;
    color: #64748b;
    padding: 9px 18px;
    margin-right: 4px;
    border: none;
    border-bottom: 3px solid transparent;
}

QTabWidget#tabWidget > QTabBar::tab:hover {
    color: #0f172a;
}

QTabWidget#tabWidget > QTabBar::tab:selected {
    color: #2563eb;
    border-bottom: 3px solid #2563eb;
}

/* ---------- Module sub-tabs: segmented control over a white card ---------- */

QTabWidget::pane {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    top: -1px;
}

QTabBar::tab {
    background: #e2e8f0;
    color: #475569;
    padding: 5px 14px;
    margin-right: 2px;
    border: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

QTabBar::tab:hover {
    background: #cbd5e1;
}

QTabBar::tab:selected {
    background: #ffffff;
    color: #2563eb;
}

/* ---------- Cards ---------- */

QGroupBox {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    margin-top: 18px;
    padding-top: 6px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 4px;
    color: #2563eb;
    background: transparent;
}

/* ---------- Inputs ---------- */

QLineEdit, QDateEdit, QDateTimeEdit, QSpinBox, QComboBox, QTextEdit, QPlainTextEdit {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 1px 8px;
    color: #0f172a;
}

QLineEdit:hover, QDateEdit:hover, QComboBox:hover, QTextEdit:hover, QPlainTextEdit:hover {
    border-color: #94a3b8;
}

QLineEdit:focus, QDateEdit:focus, QDateTimeEdit:focus, QSpinBox:focus,
QComboBox:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #2563eb;
}

QLineEdit:disabled, QComboBox:disabled {
    background: #f1f5f9;
    color: #94a3b8;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    selection-background-color: #dbeafe;
    outline: 0;
}

/* ---------- Buttons ---------- */

QPushButton {
    background: #2563eb;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 3px 6px;
}

QPushButton:hover {
    background: #1d4ed8;
}

QPushButton:pressed {
    background: #1e40af;
}

QPushButton:disabled {
    background: #cbd5e1;
    color: #f8fafc;
}

QPushButton::menu-indicator {
    subcontrol-position: right center;
    right: 6px;
}

QRadioButton, QCheckBox {
    background: transparent;
    color: #334155;
    spacing: 6px;
}

/* ---------- Tables ---------- */

QTableView {
    background: #ffffff;
    alternate-background-color: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    gridline-color: #f1f5f9;
    outline: 0;
}

QTableView::item {
    padding: 0 6px;
    border: none;
}

QTableView::item:selected {
    background: #dbeafe;
    color: #0f172a;
}

QHeaderView {
    background: transparent;
}

QHeaderView::section {
    background: #f8fafc;
    color: #64748b;
    font-weight: 600;
    border: none;
    border-bottom: 1px solid #e2e8f0;
    padding: 6px 8px;
}

QTableCornerButton::section {
    background: #f8fafc;
    border: none;
}

QTextBrowser {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 6px;
    color: #334155;
}

QScrollArea {
    background: #0f172a;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
}

/* ---------- Scrollbars ---------- */

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle {
    background: #cbd5e1;
    border-radius: 3px;
    min-height: 24px;
    min-width: 24px;
}

QScrollBar::handle:hover {
    background: #94a3b8;
}

QScrollBar::add-line, QScrollBar::sub-line,
QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
    border: none;
    width: 0;
    height: 0;
}

QMessageBox QLabel {
    color: #0f172a;
}

QToolTip {
    background: #0f172a;
    color: #ffffff;
    border: none;
    padding: 4px 8px;
}
